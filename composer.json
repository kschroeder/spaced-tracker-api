{
    "name": "kschroeder/spaced-tracker-api",
    "description": "Embeddable HTTP API for kschroeder/spaced-tracker, with attribute routes and a PHP built-in-server entrypoint.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": ["space-track", "api", "psr-15", "fastapi"],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "kschroeder/spaced-tracker": "^1.0",
        "nikic/fast-route": "^1.3",
        "nyholm/psr7": "^1.8",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "SpacedTracker\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SpacedTracker\\Api\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/spaced-tracker-api"
    ],
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "stan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/kschroeder/spaced-tracker"
        }
    ]
}
